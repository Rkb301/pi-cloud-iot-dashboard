# Copy to .env and protect with chmod 600; do not commit secrets.
# MOCK_GPIO=1 is safe on a Linux laptop. On the Raspberry Pi, only use 0 AFTER verifying the wiring.
MOCK_GPIO=1
ENABLE_MQTT=0
ADAFRUIT_IO_USERNAME=your_username_here
ADAFRUIT_IO_KEY=your_private_key_here
THINGSPEAK_WRITE_API_KEY=your_thingspeak_channel_write_key_here
ENABLE_THINGSPEAK=0
THINGSPEAK_INTERVAL_SECONDS=30
ALLOW_MOCK_CLOUD=0
DASHBOARD_TOKEN=replace-with-a-unique-long-random-secret
# Default listens only on the Pi itself. Changing to 0.0.0.0 exposes HTTP on your network.
WEB_HOST=127.0.0.1
WEB_PORT=5000
GPIOZERO_PIN_FACTORY=lgpio
IR_ACTIVE_LOW=1
FLAME_ACTIVE_LOW=1
# GPIO pin mapping used in this standalone demonstration; verify on your own Raspberry Pi.
PIN_DHT=22
PIN_IR=17
PIN_FLAME=27
PIN_LED1=5
PIN_LED2=6
# Some setups optionally mirror the second LED onto GPIO4.
# Enable ONLY if you have actually wired GPIO4 as that second blue LED line.
PIN_LED2_MIRROR=
# The uploaded daemon also describes relay=GPIO18 and ultrasonic=GPIO23/24;
# this application deliberately does not control them.
# Set only on the Pi after explicit approval and powered-off wiring inspection.
HARDWARE_CONFIRMED=0
# Application budget; other clients/toggles share the account quota.
MQTT_POINTS_PER_MINUTE=20
DHT_INTERVAL_SECONDS=3
